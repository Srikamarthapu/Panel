# Optional voice services. Leave blank for text-only use.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional Jev: can instead be entered in Models > Jev within Panel.
TYPESAFE_API_KEY=
# Hermes/provider credentials belong in `hermes setup`, not in this repository.
# Paths are optional; defaults are ~/.hermes and ~/.hermes/hermes-agent.
# HERMES_HOME=/absolute/path/to/hermes-home
# HERMES_REPO=/absolute/path/to/hermes-agent
# HERMES_CLI_PATH=/absolute/path/to/hermes
# Optional: keep Panel sessions, tasks, run receipts and voice settings elsewhere.
# PANEL_DATA_DIR=/absolute/path/to/panel-data
